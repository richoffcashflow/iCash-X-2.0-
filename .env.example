# Server-only values. Do not add live values here or expose them with NEXT_PUBLIC_ prefixes.
DATABASE_URL=
DEALMACHINE_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
BLOOIO_API_KEY=
PAYMENT_SECRET_KEY=
META_CAPI_ACCESS_TOKEN=
# Read-only Meta Marketing API token for automatic seller ad-spend imports.
# Requires ads_read for the ad account selected in Admin > Lead costs.
META_ADS_READ_ACCESS_TOKEN=

# Contact-first Meta intake. Install its migration and bind reviewed forms first.
META_INSTANT_LEADS_ENABLED=false
META_INSTANT_CRM_EVENTS_ENABLED=false
META_LEAD_APP_SECRET=
META_LEAD_VERIFY_TOKEN=
META_LEAD_LINK_SECRET=
META_LEAD_PAGE_TOKENS={}
# Optional comma-separated Page IDs allowed to reuse the saved system-user token
# in META_ADS_READ_ACCESS_TOKEN. That token also needs actual lead/Page access.
META_LEAD_ADS_READ_PAGE_IDS=
# Read-only production form setup diagnostics; these IDs do not activate intake.
META_LEAD_SETUP_APP_ID=
META_LEAD_SETUP_PAGE_ID=
META_LEAD_SETUP_FORM_ID=
META_GRAPH_VERSION=
META_SELLER_DATASET_ID=

# Recorded incoming reception remains OFF until separately reviewed activation.
ICASH_RECORDED_RECEPTION_READY=false
# Set true only after exact SQL installation; keep true for cleanup thereafter.
ICASH_RECORDED_RECEPTION_SCHEMA_READY=false
